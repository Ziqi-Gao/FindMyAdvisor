{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Advisor Memory Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["snapshot_id", "generated_at", "generated_from_event_ids", "read_model_warning", "current_state", "next_actions", "risk_register"],
  "properties": {
    "snapshot_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string"},
    "generated_from_event_ids": {"type": "array", "items": {"type": "string"}},
    "read_model_warning": {"type": "string"},
    "current_state": {"type": "array", "items": {"type": "string"}},
    "next_actions": {"type": "array", "items": {"type": "string"}},
    "risk_register": {"type": "array", "items": {"type": "string"}}
  }
}
